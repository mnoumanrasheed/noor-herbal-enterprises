# ==============================================================================
# Noor Herbal Enterprises — Environment Variable Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit .env.local.
#
# Runtime vs Seed:
# - DATABASE_URL, AUTH_SECRET, AUTH_URL, NEXT_PUBLIC_SITE_URL: Required at runtime.
# - ADMIN_EMAIL, ADMIN_PASSWORD: Used by `npm run db:seed` to provision the admin user.
# - CLOUDINARY_*: Required at runtime on server-side for admin media uploads.
# ==============================================================================

# Database Connection (Neon PostgreSQL pooled connection)
# Server-only: Never prefix with NEXT_PUBLIC_
DATABASE_URL=postgresql://user:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require

# NextAuth / Auth.js Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=your-32-byte-secret-key-here

# Authentication Base URL (http://localhost:3000 locally, https://your-domain.vercel.app in production)
AUTH_URL=http://localhost:3000

# Canonical Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Administrator Credentials for Seeding (npm run db:seed)
ADMIN_EMAIL=admin@noorherbal.pk
ADMIN_PASSWORD=your-secure-admin-password-min-12-chars

# Cloudinary Storage for Product Imagery (Server-only credentials)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional Storefront Fallbacks (Store settings in DB override these)
NEXT_PUBLIC_CONTACT_EMAIL=noorherbalenterprises@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+923005599174
